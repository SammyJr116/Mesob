# Mesob RMS Server Environment Configuration
# Production & Local Server Environment Template

# Network configuration (bind to 0.0.0.0 so tablets and phones on restaurant LAN can connect)
PORT=4000
HOST=0.0.0.0

# Environment mode ('production' or 'development')
NODE_ENV=production

# Database Connection String (Laragon / MySQL local instance)
DATABASE_URL="mysql://root:@localhost:3306/mesob_restaurant"

# Security Secrets (IMPORTANT: Change these to long random strings in production)
JWT_SECRET="mesob-jwt-super-secret-token-key-change-in-prod"
COOKIE_SECRET="mesob-super-secret-cookie-signing-key-minimum-32-chars"

# Allowed CORS Origins (comma-separated origins allowed to access the API)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000"
