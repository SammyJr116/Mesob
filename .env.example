# Example: VITE_API_URL=http://192.168.1.50:4000/api/v1
# Example: VITE_WS_URL=http://192.168.1.50:4000

VITE_API_URL=http://localhost:4000/api/v1
VITE_WS_URL=http://localhost:4000
